# Copy to .env.local — never commit real values

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Unused on Spark — do not enable Cloud Storage
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

NEXT_PUBLIC_BB_TENANT_ID=balance-bites
NEXT_PUBLIC_BB_TENANT_NAME=Balance Bites

# Cloudflare R2 (label_assets + bb_backups). Leave USE_STORAGE=false until keys are set.
# Server-only — never prefix these with NEXT_PUBLIC_
# Jurisdiction must match the S3 endpoint host:
#   default → https://<account>.r2.cloudflarestorage.com
#   eu      → https://<account>.eu.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_BUCKET=balance-bites-ops
R2_JURISDICTION=default
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_BB_USE_STORAGE=false
